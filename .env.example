# Copy to .env. Every variable is optional; shown values are the defaults.
# Lists use JSON syntax. Nested settings use a double underscore.

KUBIDOOR_LOG_LEVEL=INFO
KUBIDOOR_HOST=127.0.0.1
KUBIDOOR_PORT=8000
# SQLite by default. PostgreSQL: postgresql+psycopg://user:password@host:5432/kubidoor (pip install ".[postgres]")
KUBIDOOR_DATABASE_URL=sqlite:///./kubidoor.db
# Optional shared bearer token protecting /api/v1/*  (leave empty to disable)
KUBIDOOR_API_TOKEN=

# --- Kubernetes connection (auto: in-cluster first, then kubeconfig)
# KUBIDOOR_KUBERNETES__KUBECONFIG=/path/to/kubeconfig
# KUBIDOOR_KUBERNETES__CONTEXT=kind-kubidoor
# KUBIDOOR_KUBERNETES__METRICS_ENABLED=true

# --- Monitoring
KUBIDOOR_MONITORING__INTERVAL_SECONDS=30
# Empty list = all namespaces
KUBIDOOR_MONITORING__NAMESPACES=[]
KUBIDOOR_MONITORING__PENDING_THRESHOLD_SECONDS=300
KUBIDOOR_MONITORING__NOT_READY_THRESHOLD_SECONDS=120
KUBIDOOR_MONITORING__RESTART_THRESHOLD=5
KUBIDOOR_MONITORING__DEPLOYMENT_GRACE_SECONDS=300

# --- Recovery: DISABLED, dry-run and approval-gated by default. Read docs/recovery-policy.md first.
KUBIDOOR_RECOVERY__ENABLED=false
KUBIDOOR_RECOVERY__DRY_RUN=true
KUBIDOOR_RECOVERY__REQUIRE_APPROVAL=true
KUBIDOOR_RECOVERY__ALLOWED_NAMESPACES=["demo"]
KUBIDOOR_RECOVERY__BLOCKED_NAMESPACES=["kube-system"]
KUBIDOOR_RECOVERY__ALLOWED_ACTIONS=["deployment_restart","pod_delete"]
KUBIDOOR_RECOVERY__COOLDOWN_SECONDS=300
KUBIDOOR_RECOVERY__MAX_ACTIONS_PER_HOUR=5
KUBIDOOR_RECOVERY__VERIFY_AFTER_ACTION=true
